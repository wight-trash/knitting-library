{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guided-knitting/guide-schema/0.2",
  "title": "guide-schema",
  "description": "A knitting pattern as a guided structure, built by code from the AI's marks and the pattern text. Values are copied as written; conversion and arithmetic happen when the guide is shown.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build",
    "pattern",
    "options",
    "size_guide",
    "gauge",
    "needles",
    "yarns",
    "notions",
    "abbreviations",
    "techniques",
    "charts",
    "sections",
    "pieces",
    "reminders",
    "links",
    "doubts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.2"
      ]
    },
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/build"
        },
        {
          "type": "null"
        }
      ]
    },
    "pattern": {
      "$ref": "#/$defs/pattern"
    },
    "options": {
      "$ref": "#/$defs/options"
    },
    "size_guide": {
      "$ref": "#/$defs/size_guide"
    },
    "gauge": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gauge"
      }
    },
    "needles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/needle"
      }
    },
    "yarns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/yarn"
      }
    },
    "notions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notion"
      }
    },
    "abbreviations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/abbreviation"
      }
    },
    "techniques": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/technique"
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chart"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "pieces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/piece"
      }
    },
    "reminders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reminder"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "doubts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/doubt"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "quote",
        "from_picture"
      ],
      "properties": {
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "description": "1-based PDF page"
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "type": "string",
          "description": "Word for word from the pattern, short"
        },
        "from_picture": {
          "type": "boolean",
          "description": "Read from an image rather than the text layer"
        }
      },
      "description": "Where in the pattern this came from."
    },
    "unit": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "stitches",
            "rows",
            "rounds",
            "row_pairs",
            "repeats",
            "times",
            "cm",
            "mm",
            "in",
            "m",
            "yd",
            "g",
            "oz",
            "balls",
            "skeins",
            "pieces",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "per_size": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "One entry per size, in options.sizes order: the value as written, \"-\" when it does not apply to that size, null when the pattern gives none."
    },
    "by_choice": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice",
          "by_size"
        ],
        "properties": {
          "choice": {
            "type": "string",
            "description": "An id from options.choices[].values[].id"
          },
          "by_size": {
            "$ref": "#/$defs/per_size"
          }
        }
      }
    },
    "sized_alt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "unit",
        "all",
        "by_size",
        "by_choice"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "The original text, e.g. \"92-96-100 sts\" or \"13 (15, 17)\""
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "all": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same value for every size"
        },
        "by_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/per_size"
            },
            {
              "type": "null"
            }
          ]
        },
        "by_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/by_choice"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the value also depends on an extra choice such as yarn weight"
        }
      },
      "description": "The same value in another unit, as the pattern also gives it (e.g. inches beside cm)."
    },
    "sized_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "unit",
        "all",
        "by_size",
        "by_choice",
        "from_picture",
        "alt"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "The original text, e.g. \"92-96-100 sts\" or \"13 (15, 17)\""
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "all": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same value for every size"
        },
        "by_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/per_size"
            },
            {
              "type": "null"
            }
          ]
        },
        "by_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/by_choice"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the value also depends on an extra choice such as yarn weight"
        },
        "from_picture": {
          "type": "boolean"
        },
        "alt": {
          "anyOf": [
            {
              "$ref": "#/$defs/sized_alt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A value that may differ by size and choice. At most one of all/by_size/by_choice; none of them means the pattern gives no value. Values are copied, never converted or calculated."
    },
    "applies_to": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sizes",
            "choices",
            "except"
          ],
          "properties": {
            "sizes": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Size ids; null means all sizes"
            },
            "choices": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Choice value ids; null means all"
            },
            "except": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "size",
                  "choice"
                ],
                "properties": {
                  "size": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "choice": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "description": "Combinations excluded, e.g. fingering M"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Which sizes and choices this applies to. null means all."
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "designer",
        "publisher",
        "pattern_number",
        "language",
        "translated_from",
        "units_in_source",
        "garment",
        "construction",
        "made_to_measure",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "designer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pattern_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "type": "string"
        },
        "translated_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "units_in_source": {
          "type": "string",
          "enum": [
            "cm",
            "in",
            "cm_first",
            "in_first"
          ]
        },
        "garment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "construction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "made_to_measure": {
          "type": "boolean",
          "description": "Stitch counts are placeholders the knitter works out"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sizes",
        "size_notation",
        "choices"
      ],
      "properties": {
        "sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "size_notation": {
          "type": "string",
          "description": "How per-size values are written, e.g. \"dash list\", \"a (b, c)\", \"a (b) c (d)\""
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "description": "At most two choices besides size"
        }
      }
    },
    "size_guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page",
        "measurements"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "image",
            "both",
            "list",
            "none"
          ]
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/sized_value"
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        }
      }
    },
    "gauge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "stitches",
        "rows",
        "rows_unit",
        "over",
        "stitch_pattern",
        "condition",
        "applies_to",
        "source"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "stitches": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rows": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rows_unit": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "rows",
                "rounds",
                "round_pairs"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "over": {
          "anyOf": [
            {
              "type": "string",
              "description": "As written, e.g. \"10 cm\", \"4 in\""
            },
            {
              "type": "null"
            }
          ]
        },
        "stitch_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "condition": {
          "anyOf": [
            {
              "type": "string",
              "description": "e.g. \"after felting\""
            },
            {
              "type": "null"
            }
          ]
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "needle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "size_mm",
        "size_us",
        "size_uk",
        "kinds",
        "length",
        "use",
        "applies_to",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "size_mm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "size_us": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "size_uk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "circular",
              "straight",
              "double_pointed",
              "crochet_hook",
              "other"
            ]
          }
        },
        "length": {
          "anyOf": [
            {
              "$ref": "#/$defs/sized_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "use": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "yarn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "weight",
        "fibre",
        "ball",
        "colour",
        "strand_group",
        "alternative_group",
        "alternatives_text",
        "amount",
        "applies_to",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fibre": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ball": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "colour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "strand_group": {
          "anyOf": [
            {
              "type": "string",
              "description": "Yarns sharing a strand_group are held together"
            },
            {
              "type": "null"
            }
          ]
        },
        "alternative_group": {
          "anyOf": [
            {
              "type": "string",
              "description": "Different alternative_group values are alternatives (\"or use\")"
            },
            {
              "type": "null"
            }
          ]
        },
        "alternatives_text": {
          "anyOf": [
            {
              "type": "string",
              "description": "Alternatives given without a named yarn, e.g. \"yarn group A + A or C\""
            },
            {
              "type": "null"
            }
          ]
        },
        "amount": {
          "$ref": "#/$defs/sized_value"
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "notion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "amount",
        "applies_to",
        "source"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/sized_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "abbreviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abbr",
        "meaning",
        "defined_in_pattern",
        "source"
      ],
      "properties": {
        "abbr": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        },
        "defined_in_pattern": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Used as {name} in the text"
        },
        "value": {
          "$ref": "#/$defs/sized_value"
        }
      }
    },
    "technique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "slots",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "page",
        "kind",
        "applies_to",
        "width",
        "height",
        "start_points",
        "written_alternative",
        "notes",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "vector",
            "text"
          ]
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        },
        "width": {
          "anyOf": [
            {
              "$ref": "#/$defs/sized_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "$ref": "#/$defs/sized_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "label",
              "value"
            ],
            "properties": {
              "section_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "value": {
                "$ref": "#/$defs/sized_value"
              }
            }
          },
          "description": "Where to start, per section or piece where it differs"
        },
        "written_alternative": {
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
